# Groq API Key for LLaMA 3.3 70B and Whisper STT
# Add your Groq key below or FluenSpeak will use smart simulated responses with zero delay
GROQ_API_KEY=

# Groq Model IDs
GROQ_CHAT_MODEL=llama-3.3-70b-versatile
GROQ_FAST_MODEL=llama-3.1-8b-instant
GROQ_WHISPER_MODEL=whisper-large-v3

# Server Settings
HOST=0.0.0.0
PORT=8000
ENVIRONMENT=development

# TTS Settings (Edge TTS voice)
DEFAULT_TTS_VOICE=en-US-JennyNeural
